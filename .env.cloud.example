# Configure in Vercel > Project > Settings > Environment Variables.
# Never use VITE_ prefixes for secrets. Production and Preview need separate databases.
NOTEBOOK_STORAGE=postgres
DATABASE_URL=postgresql://REPLACE_WITH_NEON_POOLED_CONNECTION
NOTEBOOK_KEY_HASH=REPLACE_WITH_OUTPUT_OF_python_-m_scripts.cloud_key
NOTEBOOK_ALLOWED_HOSTS=notes.example.com
NOTEBOOK_ALLOWED_ORIGINS=https://notes.example.com
